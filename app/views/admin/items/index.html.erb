<div class="container mt-4">
  <div class="row mb-3">
    <div class="col-md-6">
      <h2>商品一覧</h2>
    </div>
    <div class="col-md-6 text-end">
      <%= link_to "商品新規登録", new_admin_item_path, class: "btn btn-success" %>
    </div>
  </div>

  <table class="table table-hover">
    <thead class="table-light">
      <tr>
        <th>商品ID</th>
        <th>商品名</th>
        <th>税抜価格</th>
        <th>ジャンル</th>
        <th>ステータス</th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= item.id %></td>
          <td><%= link_to item.name, admin_item_path(item) %></td>
          <td><%= number_to_currency(item.price, unit: "", precision: 0) %></td>
          <td><%= item.genre.name %></td>
          <td>
            <% if item.active? %>
              <span class="badge bg-success">販売中</span>
            <% else %>
              <span class="badge bg-secondary">販売停止中</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @items %>
</div>
