<div class="container mt-4">
  <h2 class="mb-4">商品詳細</h2>

  <div class="row">
    <!-- 商品画像 -->
    <div class="col-md-4">
      <% if @item.image.attached? %>
        <%= image_tag @item.image, class: "img-fluid rounded", style: "max-width: 100%;" %>
      <% else %>
        <div class="bg-light text-center py-5 rounded">
          <p class="text-muted">画像なし</p>
        </div>
      <% end %>
    </div>

    <!-- 商品情報 -->
    <div class="col-md-8">
      <table class="table">
        <tr>
          <th style="width: 200px;" class="table-light">商品名</th>
          <td><%= @item.name %></td>
        </tr>
        <tr>
          <th class="table-light">商品説明</th>
          <td><%= simple_format(@item.introduction) %></td>
        </tr>
        <tr>
          <th class="table-light">ジャンル</th>
          <td><%= @item.genre.name %></td>
        </tr>
        <tr>
          <th class="table-light">税込価格<br><span class="text-muted small">(税抜価格)</span></th>
          <td>
            <%= number_to_currency(@item.with_tax_price, unit: "", precision: 0) %> 
            (<%= number_to_currency(@item.price, unit: "", precision: 0) %>) 円
          </td>
        </tr>
        <tr>
          <th class="table-light">販売ステータス</th>
          <td>
            <% if @item.active? %>
              <span class="badge bg-success">販売中</span>
            <% else %>
              <span class="badge bg-secondary">販売停止中</span>
            <% end %>
          </td>
        </tr>
      </table>

      <div class="mt-4">
        <%= link_to "編集する", edit_admin_item_path(@item), class: "btn btn-primary btn-lg" %>
        <%= link_to "戻る", admin_items_path, class: "btn btn-secondary btn-lg ms-3" %>
      </div>
    </div>
  </div>
</div>
