<div class="container mt-4">
  <h2 class="mb-4">商品新規登録</h2>

  <%= form_with model: @item, url: admin_items_path, local: true do |f| %>
    
    <% if @item.errors.any? %>
      <div class="alert alert-danger">
        <h5><%= pluralize(@item.errors.count, "個のエラー") %>が発生しました</h5>
        <ul>
          <% @item.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- 商品画像 -->
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">商品画像</label>
      <div class="col-sm-10">
        <%= f.file_field :image, accept: "image/*", class: "form-control" %>
      </div>
    </div>

    <!-- 商品名 -->
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">商品名</label>
      <div class="col-sm-10">
        <%= f.text_field :name, class: "form-control", placeholder: "商品名" %>
      </div>
    </div>

    <!-- 商品説明 -->
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">商品説明</label>
      <div class="col-sm-10">
        <%= f.text_area :introduction, class: "form-control", rows: 4, placeholder: "ここに説明文を記述します" %>
      </div>
    </div>

    <!-- ジャンル -->
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">ジャンル</label>
      <div class="col-sm-10">
        <%= f.collection_select :genre_id, @genres, :id, :name, 
            { prompt: "-- 選択してください --" }, 
            { class: "form-select" } %>
      </div>
    </div>

    <!-- 税抜価格 -->
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">税抜価格</label>
      <div class="col-sm-10">
        <div class="input-group" style="max-width: 300px;">
          <%= f.number_field :price, class: "form-control", placeholder: "1000" %>
          <span class="input-group-text">円</span>
        </div>
      </div>
    </div>

    <!-- 販売ステータス -->
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">販売ステータス</label>
      <div class="col-sm-10">
    <div class="form-check">
        <%= f.radio_button :is_active, true, checked: true, class: "form-check-input" %>
        <%= f.label :is_active_true, "販売中", class: "form-check-label" %>
        </div>
    <div class="form-check">
        <%= f.radio_button :is_active, false, class: "form-check-input" %>
        <%= f.label :is_active_false, "販売停止中", class: "form-check-label" %>
        </div>

    <!-- 新規登録ボタン -->
    <div class="row">
      <div class="col-sm-10 offset-sm-2">
        <%= f.submit "新規登録", class: "btn btn-success btn-lg" %>
        <%= link_to "戻る", admin_items_path, class: "btn btn-secondary btn-lg ms-3" %>
      </div>
    </div>

  <% end %>
</div>
