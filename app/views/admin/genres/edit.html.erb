<h1>ジャンル編集<h1>
<% if @genre.errors.any? %>
  <div style="color: red;">
    <% @genre.errors.full_messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
<% end %>
<%= form_with model: @genre, url:admin_genre_path(@genre),method: :patch, local: true do |f| %>
  <%= f.label :name, "ジャンル名" %>
  <%= f.text_field :name, value: @genre.name %>

  <%= f.label :is_active, "有効フラグ" %>
  <%= f.check_box :is_active %>
  <%= f.submit "更新" %>
<% end %>