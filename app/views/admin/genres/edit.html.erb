<div class="container mt-5" style="max-width: 600px;">
  
  <h1 class="mb-3">ジャンル編集</h1>

  <% if @genre.errors.any? %>
    <div class="alert alert-danger">
      <% @genre.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @genre, url: admin_genre_path(@genre), method: :patch, local: true do |f| %>

    <div class="mb-3">
      <%= f.label :name, "ジャンル名" %>
      <%= f.text_field :name, value: @genre.name, class: "form-control" %>
    </div>

    <div class="form-group mt-3">
      <%= f.lable :is_active, "有効フラグ" %>
      <%= f.check_box :is_active %>
    </div>

    <%= f.submit "変更を保存", class: "btn btn-success" %>

  <% end %>

</div>
