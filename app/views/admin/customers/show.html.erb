<div class="container mt-5">

  <h2 class="bg-light p-2 d-inline-block mb-4"><%= @customer.last_name %><%= @customer.first_name %>さんの会員詳細</h2>

  <div class="d-flex align-items-center mb-3">
    <h4 class="mb-0">登録情報</h4>
  </div>

  <table class="table table-bordered bg-white">
    <tr>
      <th style="width: 20%;">氏名</th>
      <td><%= @customer.last_name %><%= @customer.first_name %></td>
    </tr>
    <tr>
      <th>カナ</th>
      <td><%= @customer.last_name_kana %><%= @customer.first_name_kana %></td>
    </tr>
    <tr>
      <th>郵便番号</th>
      <td><%= @customer.postal_code %></td>
    </tr>
    <tr>
      <th>住所</th>
      <td><%= @customer.address %></td>
    </tr>
    <tr>
      <th>電話番号</th>
      <td><%= @customer.telephone_number %></td>
    </tr>
    <tr>
      <th>メールアドレス</th>
      <td><%= @customer.email %></td>
    </tr>
    <tr>
      <th>会員ステータス</th>
      <td>
        <% if @customer.is_active %>
          <span class="text-success fw-bold">有効</span>
        <% else %>
          <span class="text-secondary fw-bold">退会</span>
        <% end %>
      </td>
    </tr>
  </table>

  <div class="row mt-4">
    <div class="col-md-3 mb-3">
      <%= link_to "編集する",  edit_admin_customer_path, class: "btn btn-success btn-sm ml-3 ms-3" %>
    </div>

    <div class="col-md-3 mb-3">
      <%= link_to "注文履歴一覧を見る", admin_orders_path, class: "btn btn-primary btn-block w-100" %>
    </div>
  </div>

</div>
