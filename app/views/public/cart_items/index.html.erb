<div class="container">
  <h2>ショッピングカート</h2>
  
  <% if @cart_items.any? %>
    <div class="text-right mb-3">
      <%= button_to "カートを空にする", destroy_all_cart_items_path, method: :delete, data: { confirm: "本当にカートを空にしますか?" }, class: "btn btn-danger" %>
    </div>
    
    <table class="table">
      <thead>
        <tr>
          <th>商品名</th>
          <th>単価（税込）</th>
          <th>数量</th>
          <th>小計</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @cart_items.each do |cart_item| %>
          <tr>
            <td>
              <%= link_to cart_item.product.name, item_path(cart_item.product) %>
            </td>
            <td>
              ¥<%= number_to_currency(cart_item.product.with_tax_price, unit: "", precision: 0) %>
            </td>
            <td>
              <%= form_with model: cart_item, url: cart_item_path(cart_item), method: :patch, local: true do |f| %>
                <%= f.number_field :amount, value: cart_item.amount, min: 1, class: "form-control", style: "width: 100px; display: inline-block;" %>
                <%= f.submit "変更", class: "btn btn-sm btn-success" %>
              <% end %>
            </td>
            <td>
              ¥<%= number_to_currency(cart_item.subtotal, unit: "", precision: 0) %>
            </td>
            <td>
              <%= button_to "削除", cart_item_path(cart_item), method: :delete, data: { confirm: "削除しますか?" }, class: "btn btn-sm btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    
    <div class="text-right">
      <h4>合計金額: ¥<%= number_to_currency(@total, unit: "", precision: 0) %></h4>
      <%= link_to "買い物を続ける", items_path, class: "btn btn-secondary" %>
      <%= link_to "注文情報入力へ進む", new_order_path, class: "btn btn-success btn-lg" %>
    </div>
    
  <% else %>
    <p class="text-center my-5">カートに商品がありません</p>
    <%= link_to "買い物を続ける", items_path, class: "btn btn-primary" %>
  <% end %>
</div>
