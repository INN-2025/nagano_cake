<div class="container mt-5" style="max-width: 500px;">

  <h2 class="mb-4">ログイン</h2>

  <p class="mb-2">会員の方はこちらからログイン</p>

  <%= form_with(model: resource, as: resource_name, url: session_path(resource_name), local: true) do |f| %>

    <div class="mb-3">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, class: "form-control", autofocus: true %>
    </div>

    <div class="mb-3">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, class: "form-control" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="form-check mb-3">
        <%= f.check_box :remember_me, class: "form-check-input" %>
        <%= f.label :remember_me, "ログイン状態を保持する", class: "form-check-label" %>
      </div>
    <% end %>

    <div class="d-grid">
      <%= f.submit "ログイン", class: "btn btn-primary" %>
    </div>

  <% end %>

  <div class="mt-4">
    <p>会員登録がお済みでない方</p>
    <%= link_to "こちら", new_customer_registration_path %> から新規登録を行ってください。
  </div>

</div>