<div class="container">
  <div class="row">
    <div class="col-md-6">
      <div class="bg-secondary text-white text-center p-5">
        商品画像
      </div>
    </div>
    
    <div class="col-md-6">
      <h2><%= @product.name %></h2>
      <p><%= @product.introduction %></p>
      <h4>¥<%= number_to_currency(@product.with_tax_price, unit: "", precision: 0) %> (税込)</h4>
      
      <%= form_with model: @cart_item, url: cart_items_path, local: true do |f| %>
        <%= f.hidden_field :product_id, value: @product.id %>
        <div class="form-group">
          <%= f.label :amount, "個数" %>
          <%= f.number_field :amount, value: 1, min: 1, class: "form-control" %>
        </div>
        <%= f.submit "カートに入れる", class: "btn btn-success btn-lg" %>
      <% end %>
    </div>
  </div>
</div>
