<h2>注文情報入力<h2>

<%= form_with model: @order, url: orders_confirm_path, method: :post, local: true do |f| %>

  <h3>支払い方法<h3>
  <div>
    <%= f.radio_button :payment_method, "credit_card" %>
    <%= f.label :payment_method_credit_card,"クレジットカード" %><br>
    <%= f.radio_button :payment_method, "bank_transfer" %>
    <%= f.label :payment_method_bank_transfer,"銀行振込" %>
  </div>

  <hr>

  <h3>お届け先<h3>

  <div>
    <%= f.radio_button :address_option, "own" %>
    <%= f.label :address_option, "ご自身の住所" %><br>
    <%= current_customer.postal_code %>
    <%= current_customer.address %>
    <%= current_customer.last_name + current_customer.first_name %>
  </div>

  <div>
    <%= f.radio_button :address_option, "new" %>
    <%= f.label :address_option, "新しいお届け先" %><br>

    <%= f.label :postal_code, "郵便番号(ハイフンなし)" %>
    <%= f.text_field :postal_code %><br>

    <%= f.label :address, "住所" %>
    <%= f.text_field :address %><br>

    <%= f.label :name, "宛名" %>
    <%= f.text_field :name %><br>
  </div>

    <%= f.submit "確認画面へ進む", class:"btn btn-primary" %>

<% end %>