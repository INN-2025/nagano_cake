<h2>注文情報確認</h2>

<table border="1" cellpadding="8" cellspacing="0">
  <thead>
    <tr>
      <th>商品名</th>
      <th>単価(税込)</th>
      <th>数量</th>
      <th>小計</th>
    </tr>
  </thead>

  <tbody>
    <% @total = 0 %>
    <% @cart_items.each do |cart_item| %>
      <% subtotal = cart_item.product.price * cart_item.amount %>
      <% @total += subtotal %>

      <tr>
        <td><%= cart_item.product.name %></td>
        <td><%= subtotal %>円</td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<table border="1" cellpadding="8" cellspacing="0">
  <tr>
    <th>送料</th>
    <td>800円</td>
  </tr>
  <tr>
    <th<合計請求額</th>
    <% @billing = @total + 800 %>
    <td><%= @billing %>円</td>
  </tr>
</table>

<br>

<h3>支払い方法</h3>
<p>
  <% if @order.payment_method == "credit_card" %>
    クレジットカード
  <% else %>
    銀行振込
  <% end %>
</p>

<h3>お届け先</h3>
<p>
  〒<%= @order.postal_code %><br>
  <%= @order.address %><br>
  <%= @order.name %>
</p>

<br>

<%= form_with model: @order, url:orders_path do |f| %>
  <%= f.hidden_field :payment_method %>
  <%= f.hidden_field :postal_code %>
  <%= f.hidden_field :address %>
  <%= f.hidden_field :name %>
  <%= f.submit "注文を確定する", class: "btn btn-success" %>
<% end %>