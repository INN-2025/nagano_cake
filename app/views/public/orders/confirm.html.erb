<% content_for :main_class,"orders-confirm" %>

<h2>注文情報確認</h2>

<div class="row">

  <!-- 左：商品一覧テーブル -->
  <div class="col-md-8">
    <div class="card-frame">
      <table class="table table-bordered">
        <thead>
          <tr>
            <th>商品名</th>
            <th>単価(税込)</th>
            <th>数量</th>
            <th>小計</th>
          </tr>
        </thead>
        <tbody>
          <% @total = 0 %>
          <% @cart_items.each do |cart_item| %>
            <% subtotal = cart_item.product.with_tax_price * cart_item.amount %>
            <% @total += subtotal %>
            <tr>
              <td><%= cart_item.product.name %></td>
              <td><%= cart_item.product.with_tax_price %>円</td>
              <td><%= cart_item.amount %></td>
              <td><%= subtotal %>円</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 右：送料・商品合計・請求金額 -->
  <div class="col-md-4">
    <table class="table table-bordered">
      <tr>
        <th>送料</th>
        <td>800円</td>
      </tr>
      <tr>
        <th>商品合計</th>
        <td><%= @total %>円</td>
      </tr>
      <tr>
        <th>請求金額</th>
        <% @billing = @total + 800 %>
        <td><%= @billing %>円</td>
      </tr>
    </table>
  </div>
</div>

<!-- 支払い方法 -->
<h3>支払い方法</h3>
<p>
  <% if @order.payment_method == "credit_card" %>
    クレジットカード
  <% else %>
    銀行振込
  <% end %>
</p>

<!-- お届け先 -->
<h3>お届け先</h3>
<p>
  〒<%= @order.postal_code %><br>
  <%= @order.address %><br>
  <%= @order.name %>
</p>

<!-- 注文ボタン -->
<%= form_with model: @order, url: orders_path do |f| %>
  <%= f.hidden_field :payment_method %>
  <%= f.hidden_field :postal_code %>
  <%= f.hidden_field :address %>
  <%= f.hidden_field :name %>

  <%= f.submit "注文を確定する", class: "btn btn-success" %>
<% end %>
