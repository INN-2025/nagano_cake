<h2>注文履歴詳細</h2>

<h3>注文情報</h3>
<p>注文日:<%= @order.created_at.strftime("%Y/%m/%d") %></p>
<p>配送先:〒<%= @order.postal_code %><br>
<%= @order.address %><br>
<%= @order.name %></p>
<p>支払方法:<%= @order.payment_method_i18n %></p>
<p>ステータス:<%= @order.status_i18n %></p>

<h3>請求情報</h3>
<table>
  <tr><th>商品合計</th><td><%= @order.total_payment - @order.shipping_cost %></td></tr>
  <tr><th>配送料</th><td><%= @order.shipping_cost %></td></tr>
  <tr><th>ご請求額</th><td><%= @order.total_payment %></td></tr>
</table>

<h3>注文内容</h3>
<table>
  <thead>
    <tr>
      <th>商品</th>
      <th>単価(税込)</th>
      <th>個数</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
    <% @order_details.each do |od| %>
      <tr>
        <td><%= od.product.name %></td>
        <td><%= od.product.price %></td>
        <td><%= od.amount %></td>
        <td><%= od.product.price * od.amount %></td>
      </tr>
    <% end %>
  </tbody>
</table>
