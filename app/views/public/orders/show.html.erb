<h2>注文履歴詳細</h2>

<div class="card mt-4 p-4">

  <div class="row">

    <!-- 注文情報（左） -->
    <div class="col-md-6">
      <h3>注文情報</h3>
      <table class="table table-bordered">
        <tr>
          <th>注文日</th>
          <td><%= @order.created_at.strftime("%Y/%m/%d") %></td>
        </tr>
        <tr>
          <th>配送先</th>
          <td>
            〒<%= @order.postal_code %><br>
            <%= @order.address %><br>
            <%= @order.name %>
          </td>
        </tr>
        <tr>
          <th>支払方法</th>
          <td><%= @order.payment_method_i18n %></td>
        </tr>
        <tr>
          <th>ステータス</th>
          <td><%= @order.status_i18n %></td>
        </tr>
      </table>
    </div>

    <!-- 請求情報（右） -->
    <div class="col-md-6">
      <h3>請求情報</h3>
      <table class="table table-bordered">
        <tr>
          <th>商品合計</th>
          <td><%= number_with_delimiter(@order.total) %>円</td>
        </tr>
        <tr>
          <th>配送料</th>
          <td><%= number_with_delimiter(@order.shipping_cost) %>円</td>
        </tr>
        <tr>
          <th>ご請求額</th>
          <td><%= number_with_delimiter(@order.billing_amount) %>円</td>
        </tr>
      </table>
    </div>

  </div>

  <!-- 注文内容（下） -->
  <h3 class="mt-4">注文内容</h3>
  <table class="table table-bordered">
    <thead>
      <tr>
        <th>商品</th>
        <th>単価（税込）</th>
        <th>個数</th>
        <th>小計</th>
      </tr>
    </thead>
    <tbody>
      <% @order_details.each do |detail| %>
        <tr>
          <td><%= detail.product.name %></td>
          <td><%= number_with_delimiter(detail.price_with_tax) %>円</td>
          <td><%= detail.amount %></td>
          <td><%= number_with_delimiter(detail.subtotal) %>円</td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>
