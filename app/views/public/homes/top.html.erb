<div class="container">
  <h1>ようこそ、ながのCAKEへ!</h1>
  <p>このサイトは、ケーキ販売のECサイトになります。</p>
  
  <h2>新着商品</h2>
  <div class="row">
    <% @products.each do |product| %>
      <div class="col-md-3">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title"><%= product.name %></h5>
            <p>¥<%= product.price %></p>
            <%= link_to "詳細", item_path(product), class: "btn btn-sm btn-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
  <%= link_to "全ての商品を見る", items_path, class: "btn btn-success mt-3" %>
</div>
