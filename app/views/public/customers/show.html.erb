<div class="container mt-5">

  <h2 class="bg-light p-2 d-inline-block mb-4">マイページ</h2>

  <div class="d-flex align-items-center mb-3">
    <h4 class="mb-0">登録情報</h4>
    <%= link_to "編集する",  public_customer_edit_path, class: "btn btn-success btn-sm ml-3 ms-3" %>
  </div>

  <table class="table table-bordered bg-white">
    <tr>
      <th style="width: 20%;">氏名</th>
      <td><%= @customer.last_name %><%= @customer.first_name %></td>
    </tr>
    <tr>
      <th>カナ</th>
      <td><%= @customer.last_name_kana %><%= @customer.first_name_kana %></td>
    </tr>
    <tr>
      <th>郵便番号</th>
      <td><%= @customer.postal_code %></td>
    </tr>
    <tr>
      <th>住所</th>
      <td><%= @customer.address %></td>
    </tr>
    <tr>
      <th>電話番号</th>
      <td><%= @customer.telephone_number %></td>
    </tr>
    <tr>
      <th>メールアドレス</th>
      <td><%= @customer.email %></td>
    </tr>
  </table>

  <div class="row mt-4">
    <div class="col-md-3 mb-3">
      <p class="font-weight-bold">配送先</p>
      <%= link_to "一覧を見る", addresses_path, class: "btn btn-primary btn-block w-100" %>
    </div>

    <div class="col-md-3 mb-3">
      <p class="font-weight-bold">注文履歴</p>
      <%= link_to "一覧を見る", orders_path, class: "btn btn-primary btn-block w-100" %>
    </div>
  </div>

</div>
