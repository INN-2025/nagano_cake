<h3 class="mb-4">配送先編集</h3>

<div class="row justify-content-center">
  <div class="col-md-8">

    <div class="card p-4 shadow-sm">

      <%= form_with model: @address, local: true do |f| %>

        <!-- 郵便番号 -->
        <div class="form-group row mb-3">
          <label class="col-md-3 col-form-label">郵便番号</label>
          <div class="col-md-6">
            <%= f.text_field :postal_code, class: "form-control" %>
          </div>
        </div>

        <!-- 住所 -->
        <div class="form-group row mb-3">
          <label class="col-md-3 col-form-label">住所</label>
          <div class="col-md-8">
            <%= f.text_field :address, class: "form-control" %>
          </div>
        </div>

        <!-- 宛名 -->
        <div class="form-group row mb-4">
          <label class="col-md-3 col-form-label">宛名</label>
          <div class="col-md-6">
            <%= f.text_field :name, class: "form-control" %>
          </div>
        </div>

        <div class="text-center">
          <%= f.submit "変更内容を保存", class: "btn btn-success px-4" %>
        </div>

      <% end %>

    </div><!-- card -->

  </div>
</div>