<div class="search-box d-flex justify-content-center">
  <%= form_with url: search_items_path, method: :get, local: true, class: "search-form d-flex align-items-center" do |f| %>
    <%= f.text_field :keyword, placeholder: "search", class: "form-control search-input" %>
    <button type="submit"class="search-btn"><i class="fas fa-search"></i>
    </button>
  <% end %>
</div>
