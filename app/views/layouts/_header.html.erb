<header>
  <nav class="navbar navbar-expand-lg"style="background-color:#fff;">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand" do %>
      <%= image_tag "logo.jpg", size: "400x180" %>
    <% end %>

      <!-- トグルボタン（スマホ用） -->
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavDropdown">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavDropdown">
        <ul class="navbar-nav ml-auto">

          <% if customer_signed_in? %>

            <li class="nav-item">
              <%= link_to root_path, class: 'nav-link text-light' do %>
                Home
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to about_path, class: 'nav-link text-light' do %>
                About
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to items_path, class: 'nav-link text-light' do %>
                商品一覧
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to cart_items_path, class: 'nav-link text-light' do %>
                カート
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to public_customer_my_page_path, class: 'nav-link text-light' do %>
                マイページ
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to "ログアウト", destroy_customer_session_path,
                    method: :delete, class: "nav-link text-light" %>
            </li>

          <% else %>

            <li class="nav-item">
              <%= link_to root_path, class: 'nav-link text-light' do %>
                Home
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to about_path, class: 'nav-link text-light' do %>
                About
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to items_path, class: 'nav-link text-light' do %>
                商品一覧
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to new_customer_registration_path, class: 'nav-link text-light' do %>
                Sign up
              <% end %>
            </li>

            <li class="nav-item">
              <%= link_to new_customer_session_path, class: 'nav-link text-light' do %>
                Log in
              <% end %>
            </li>

          <% end %>

        </ul>
      </div>
    </div>
  </nav>
</header>