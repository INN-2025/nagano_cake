<nav class="navbar navbar-expand-lg" style="background-color:#fff;">
  <div class="container">
    <%= link_to admin_root_path, class: "navbar-brand" do %>
      <%= image_tag "logo.jpg", size: "400x180" %>
    <% end %>

    <ul class="navbar-nav ml-auto">
      <li class="nav-item"><%= link_to "商品一覧", admin_items_path, class: "nav-link" %></li>
      <li class="nav-item"><%= link_to "会員一覧", admin_customers_path, class: "nav-link" %></li>
      <li class="nav-item"><%= link_to "注文履歴", admin_orders_path, class: "nav-link" %></li>
      <li class="nav-item"><%= link_to "ジャンル一覧", admin_genres_path, class: "nav-link" %></li>
      <li class="nav-item"><%= link_to "ログアウト", destroy_admin_session_path, method: :delete, class:"nav-link" %></li>
    </ul>
  </div>
  <% if admin_signed_in? %>
    <%= form_with url: search_admin_items_path, method: :get, local: true, class: "search-form" do |f| %>
    <%= f.text_field :keyword, placeholder: "商品検索", class: "search-input" %>
    <button type="submit" class="search-btn">
      <i class="fas fa-search"></i>
    </button>
    <% end %>

    <%= form_with url: search_admin_customers_path, method: :get, local: true, class: "search-form" do |f| %>
      <%= f.text_field :keyword, placeholder: "会員検索", class: "search-input" %>
      <button type="submit" class="search-btn">
        <i class="fas fa-search"></i>
      </button>
    <% end %>
  <% end %>
</nav>