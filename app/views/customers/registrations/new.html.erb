<h2>新規会員登録</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "public/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :last_name, "姓" %>
    <%= f.text_field :last_name %>

    <%= f.label :first_name, "名" %>
    <%= f.text_field :first_name %>
  </div>

  <div>
    <%= f.label :last_name_kana, "セイ" %>
    <%= f.text_field :last_name_kana %>

    <%= f.label :first_name_kana, "メイ" %>
    <%= f.text_field :first_name_kana %>
  </div>

  <div>
    <%= f.label :email, "メールアドレス" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div>
    <%= f.label :postal_code, "郵便番号" %>
    <%= f.text_field :postal_code %>
  </div>

  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :telephone_number, "電話番号" %>
    <%= f.text_field :telephone_number %>
  </div>

  <div>
    <%= f.label :password, "パスワード(6文字以上)" %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

    <div>
    <%= f.label :password_confirmation, "パスワード(確認用)" %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <div>
    <%= f.submit "新規登録", class: "btn btn-success" %>
  </div>
<% end %>

<p>既に登録済みの方は <%= link_to "こちら", new_customer_session_path %> からログインしてください。</p>

<%= render "public/shared/links" %>
